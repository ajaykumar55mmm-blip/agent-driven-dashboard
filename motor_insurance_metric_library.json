{
  "version": "1.0",
  "domain": "motor_insurance",
  "metrics": [
    {
      "name": "Loss Ratio",
      "status": "approved",
      "description": "Total claims paid divided by total premiums earned",
      "dax": "DIVIDE(SUM(claim_amount), SUM(premium))",
      "format": "percentage",
      "owner": "Actuarial"
    },
    {
      "name": "Total Claims",
      "status": "approved",
      "description": "Sum of all claim amounts in the selected period",
      "dax": "SUM(claim_amount)",
      "format": "currency",
      "owner": "Claims"
    },
    {
      "name": "Avg Claim Cost",
      "status": "approved",
      "description": "Average cost per claim",
      "dax": "AVERAGE(claim_amount)",
      "format": "currency",
      "owner": "Claims"
    },
    {
      "name": "Claim Count",
      "status": "approved",
      "description": "Total number of claims lodged",
      "dax": "COUNTROWS(claims)",
      "format": "number",
      "owner": "Claims"
    },
    {
      "name": "Total Premium",
      "status": "approved",
      "description": "Total gross written premium",
      "dax": "SUM(premium)",
      "format": "currency",
      "owner": "Underwriting"
    },
    {
      "name": "Frequency Rate",
      "status": "approved",
      "description": "Number of claims per policy",
      "dax": "DIVIDE(COUNTROWS(claims), DISTINCTCOUNT(policy_id))",
      "format": "decimal",
      "owner": "Actuarial"
    },
    {
      "name": "Avg Settlement Days",
      "status": "draft",
      "description": "Average number of days to settle a claim",
      "dax": "AVERAGE(settlement_days)",
      "format": "number",
      "owner": "Claims"
    },
    {
      "name": "Reopened Claims Rate",
      "status": "draft",
      "description": "Percentage of claims reopened after closure",
      "dax": "DIVIDE(COUNTROWS(FILTER(claims, claims[reopened]=TRUE)), COUNTROWS(claims))",
      "format": "percentage",
      "owner": "Claims"
    }
  ]
}
